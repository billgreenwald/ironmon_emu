<?xml version="1.0" encoding="utf-8"?>
<!-- Wide-mode (Pixel Fold) full-screen controls overlay.
     Controls anchor to left/right edges; transparent center lets game+tracker show through.
     View IDs match the normal padboard IDs so addGameControler() works unchanged.
     Button sizes are overridden programmatically via scaleWideControls(). -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/padboardInclude"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/fps_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FPS: 0"
        android:textColor="#00FF00"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="#80000000"
        android:padding="4dp"
        android:elevation="10dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true" />

    <!-- Invisible anchor required by existing code -->
    <View
        android:id="@+id/centerAnchor"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_centerInParent="true" />

    <!-- ── LEFT COLUMN ─────────────────────────────────────────── -->

    <!-- L button: top-left -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/lBtn"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:layout_marginTop="24dp"
        android:layout_marginLeft="8dp"
        android:background="@drawable/btnbackgroud"
        android:gravity="center"
        android:text="L"
        android:textColor="#303030"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- D-pad: center-left -->
    <include
        android:id="@+id/dpad"
        layout="@layout/dpad"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_marginLeft="8dp" />

    <!-- Select: bottom-left -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/selectBtn"
        android:layout_width="56dp"
        android:layout_height="32dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentLeft="true"
        android:layout_marginBottom="24dp"
        android:layout_marginLeft="8dp"
        android:background="@drawable/btnbackgroud"
        android:gravity="center"
        android:text="select"
        android:textColor="#303030"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- ── RIGHT COLUMN ────────────────────────────────────────── -->

    <!-- R button: top-right -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/rBtn"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginTop="24dp"
        android:layout_marginRight="8dp"
        android:background="@drawable/btnbackgroud"
        android:gravity="center"
        android:text="R"
        android:textColor="#303030"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- A button: upper-center-right (below R) -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/aBtn"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/btnbackgroud"
        android:gravity="center"
        android:text="A"
        android:textColor="#303030"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- B button: below A -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/bBtn"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_below="@+id/aBtn"
        android:layout_alignParentRight="true"
        android:layout_marginRight="8dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/btnbackgroud"
        android:gravity="center"
        android:text="B"
        android:textColor="#303030"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Start: bottom-right -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/startBtn"
        android:layout_width="56dp"
        android:layout_height="32dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:layout_marginBottom="24dp"
        android:layout_marginRight="8dp"
        android:background="@drawable/btnbackgroud"
        android:gravity="center"
        android:text="start"
        android:textColor="#303030"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Tools button: above Start -->
    <TextView
        android:id="@+id/tools_btn"
        android:layout_width="56dp"
        android:layout_height="32dp"
        android:layout_above="@+id/startBtn"
        android:layout_alignParentRight="true"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="6dp"
        android:text="tools"
        android:gravity="center"
        android:textColor="#303030"
        android:textSize="10sp"
        android:textStyle="bold"
        android:background="@drawable/btnbackgroud"
        android:elevation="10dp" />

    <!-- Name entry: always hidden in wide mode -->
    <LinearLayout
        android:id="@+id/nameEntryContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

</RelativeLayout>
